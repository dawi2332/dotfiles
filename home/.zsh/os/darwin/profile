# vim: ft=sh

export MANPATH=${MANPATH:-$(manpath)}
if [[ -x /usr/libexec/path_helper ]]; then
  eval "$(/usr/libexec/path_helper -s)"
fi

if [[ -x "$HOMEBREW_PREFIX/bin/pyenv" ]]; then
  eval "$($HOMEBREW_PREFIX/bin/pyenv init --path)"
fi
if [[ -x "$HOMEBREW_PREFIX/bin/rbenv" ]]; then
  eval "$($HOMEBREW_PREFIX/bin/rbenv init - --no-rehash zsh)"
fi
eval "$($HOMEBREW_PREFIX/bin/brew shellenv)"
if [[ -d $HOME/.cargo ]]; then
  . "$HOME/.cargo/env"
fi

if [[ -x $(which java) ]] && [[ $(java -version >/dev/null 2>&1) ]]; then
  if [[ -x /usr/libexec/java_home ]]; then
    JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)
  else
    JAVA_HOME="/System/Library/Frameworks/JavaVM.framework/Home"
  fi
  export JAVA_HOME
fi
